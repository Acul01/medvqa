    "pseudo_af": [
      "05_outputs/mc/FINAL/withX/pseudo-reasonings_qwen3/qwen2.5/qwen2.5_{dataset}_af"
    ],
    "pseudo_af_rf": [
      "05_outputs/mc/FINAL/withX/pseudo-reasonings_qwen3/qwen2.5/qwen2.5_{dataset}_both"
    ],
    "pseudo_som": [
