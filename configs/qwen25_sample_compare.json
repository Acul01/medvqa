    ],
    "answer_only_lora": [
      "05_outputs/mc/FINAL/noX/qwen2.5/{dataset}_MC_LoRA",
      "05_outputs/mc/FINAL/noX/qwen2.5/{dataset}_MC_lora",
      "05_outputs/mc/FINAL/noX/qwen/{dataset}_MC_lora",
      "05_outputs/mc/FINAL/noX/LoRA/qwen2.5_LoRA/{dataset}_MC_LoRA",
      "05_outputs/mc/FINAL/noX/LoRA/qwen2.5_LoRA/{dataset}_MC_lora"
    ],
    "pseudo_rf": [
      "05_outputs/mc/FINAL/withX/pseudo-reasonings_qwen3/qwen2.5/qwen2.5_{dataset}_rf"
